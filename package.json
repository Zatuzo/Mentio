    "@types/react-syntax-highlighter": "^15.5.13",
    "@uidotdev/usehooks": "^2.4.1",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "ai": "^6.0.197",
    "autoprefixer": "^10.4.20",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "jotai": "^2.20.1",
