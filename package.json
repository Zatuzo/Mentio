    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.0",
    "next-test-api-route-handler": "^5.0.5",
    "prisma": "^5.22.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7",
    "vitest-mock-extended": "^4.0.0"
  }
}
