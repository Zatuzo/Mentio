{
  "name": "mentio-mcp",
  "version": "1.0.2",
  "description": "WhatsApp mention monitoring agent with AI summaries",
  "main": "src/listener.js",
  "bin": {
    "mentio-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist/mcp-server.js"
  ],
  "scripts": {
    "dev": "concurrently -k -n listener,sessions,cron,reminders,web -c blue,cyan,magenta,yellow,green \"npm run listener\" \"npm run sessions\" \"npm run cron\" \"npm run reminders\" \"npm run web\"",
    "reminders": "node src/reminder-worker.js",
    "listener": "node src/listener.js",
    "cron": "node src/summarizer.js --cron",
    "summarize": "node src/summarizer.js --once",
    "list-groups": "node src/list-groups.js",
    "seed-test": "node src/seed-test.js",
    "migrate:multiuser": "node src/migrate-to-multiuser.js",
    "reset-claims": "node src/reset-claims.js",
    "web": "next dev -p 9000",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "keygen": "node scripts/generate-encryption-key.js",
    "keygen": "node scripts/generate-encryption-key.js",
    "postinstall": "[ \"$npm_config_global\" = \"true\" ] || prisma generate",
    "sessions": "node src/session-manager.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mcp:dev": "node scripts/mcp-server.cjs",
    "build:mcp": "esbuild scripts/mcp-server.ts --bundle --platform=node --format=cjs --outfile=dist/mcp-server.js",
    "setup:mcp": "node scripts/setup-mcp.cjs",
    "prepublishOnly": "npm run build:mcp"
  },
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/react": "^3.0.199",
    "@anthropic-ai/sdk": "^0.30.1",
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "@base-ui/react": "^1.4.1",
    "@blocknote/core": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@blocknote/shadcn": "^0.51.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
