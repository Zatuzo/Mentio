# Your WhatsApp JID, format: 62xxxxxxxxx@s.whatsapp.net
MY_JID=62xxxxxxxxx@s.whatsapp.net

# Comma-separated group JIDs to monitor (optional; can also manage via Group table)
# Example: 1203630xxxxx@g.us,1203630yyyyy@g.us
WA_GROUPS=

# Anthropic API key for summarization
ANTHROPIC_API_KEY=sk-ant-...

# Claude model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cron schedule for summarizer (default: every 4 hours)
SUMMARY_CRON=0 */4 * * *

# ─── GitHub OAuth (optional) ──────────────────────────────────────────────────
# Register an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:9000
#   Authorization callback URL: http://localhost:9000/api/auth/callback/github
# Leave these unset to keep the manual PAT flow only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the port the web app runs on (dev server uses 9000)
BETTER_AUTH_URL=http://localhost:9000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:9000

# ─── Ops alerts (optional) ────────────────────────────────────────────────────
# Telegram bot for listener-down / reconnect notifications.
# 1. Create a bot via @BotFather, copy its token here.
# 2. Get your chat_id by messaging the bot once, then visiting:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  → look for "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Listener behaviour ────────────────────────────────────────────────────────
# Per-(group, sender) mention rate limit — protects the feed and AI summary
# budget from a noisy sender or a forwarded chain spamming @mentions.
MENTION_RATE_LIMIT_MAX=5
MENTION_RATE_LIMIT_WINDOW_MS=60000

# ─── Data at rest ──────────────────────────────────────────────────────────────
# 32-byte key (as 64 hex chars, or base64) used to encrypt WhatsApp message
# text before it's written to the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset only for local experimentation — chat text is stored in plain
# text without it (a warning is logged).
ENCRYPTION_KEY=

# ─── IBM watsonx.ai (optional) ─────────────────────────────────────────────────
# Auto-tags incoming mentions with a category (request/question/urgent/info/
# other). Leave WATSONX_PROJECT_ID unset to skip this entirely — DeepSeek
# summarization/task-extraction works independently of this.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
